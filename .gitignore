```gitignore
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Coverage and test reports
coverage/
.nyc_output/

# Build output
dist/
build/

# Cache
.cache/
.parcel-cache/
.eslintcache

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Local databases and data
*.sqlite
*.sqlite3
*.db

# Optional local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local
```

